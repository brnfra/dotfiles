#!/usr/bin/env bash
# Arquivo: search-dupes
# Ultima_modificacao: 10-04-2026
# Download: git@github.com:brnfra
# Licence:Este arquivo é de domínio público
# Garantia: O autor não se responsabiliza por eventuais danos
#           causados pelo uso deste script.
# shellcheck source=dotfiles_env
. dotfiles_env

DIR="${2:-.}"
DUP_DIR="$DIR/duplicados"

mkdir -p "$DUP_DIR"

cInfo "Diretório:" "$DIR"
cInfo "Destino duplicados:" "$DUP_DIR"

function search_duplicates() {
    local OPT
    local depth
    OPT=${1:-}

    if [ -z "$1" ];then
	depth=$(( 1 ))
	OPT="-maxdepth"
    else
	depth=""
	OPT=""
    fi
    
    declare -A seen   # hash -> arquivo original
    
    # Percorre arquivos
    find "$DIR" "$OPT" $depth -type f ! -path "$DUP_DIR/*" | while read -r file; do
    
    # calcula hash
    hash=$(sha256sum "$file" | awk '{print $1}')

    if [[ -z "${seen[$hash]}" ]]; then
	# primeira vez que vemos esse hash
	seen[$hash]="$file"
	cInfo "Mantendo: $file"

    else
	# já existe um arquivo com esse hash → duplicado
	REL_PATH="${file#$DIR/}"
	DEST="$DUP_DIR/$REL_PATH"

	mkdir -p "$(dirname "$DEST")"

	cInfo "Movendo duplicado:"
	cInfo "  original: ${seen[$hash]}"
	cInfo "  duplicado: $file -> $DEST"

	mv "$file" "$DEST"
    fi

done

cInfo
cInfo "Concluído."
}

function search_duplicates_dryrun() {
       
    declare -A seen   # hash -> arquivo original
    
    # Percorre arquivos
    find "$DIR" -type f ! -path "$DUP_DIR/*" | while read -r file; do
    
    # calcula hash
    hash=$(sha256sum "$file" | awk '{print $1}')

    if [[ -z "${seen[$hash]}" ]]; then
	# primeira vez que vemos esse hash
	seen[$hash]="$file"
	cInfo "Mantendo: $file"

    else
	# já existe um arquivo com esse hash → duplicado
	REL_PATH="${file#$DIR/}"
	DEST="$DUP_DIR/$REL_PATH"
	
	#mkdir -p "$(dirname "$DEST")"

	cInfo "Movendo duplicado:"
	cInfo "  original: ${seen[$hash]}"
	cInfo "  duplicado: $file -> $DEST"

	#mv "$file" "$DEST"
    fi

done

cInfo
cInfo "Concluído. Nenhuma mudança realizada."
}



function userChoice() {
    case $1 in
	"-h"|"--help")
	    cat <<HELP
${0##*/}

NAME
    ${0##*/} - Search for files in duplicity
SYNOPSIS
    ${0##*/} [OPTION] [Path folder]
DESCRIPTION
    This script find duplicates files comparing its hash, SHA256.
    First file stay and others are move to duplicados.
Examples: 
    To search in current folder 
	${0##*/} -l .
	Movendo duplicado:
	original: ./file1.jpg
	duplicado: ./file2.jpg -> ./duplicados/file2.jpg
    To search in folder 
	${0##*/} -a "/foo"
	Movendo duplicado:
	original: /foo/file1.jpg
	duplicado: /foo/file2.jpg -> /foo/duplicados/file2.jpg
    To dry-run only 
	${0##*/} --dry-run 
	Movendo duplicado:
	original: /foo/file1.jpg
	duplicado: /foo/file2.jpg -> /foo/duplicados/file2.jpg
	Concluído. Nenhuma mudança realizada

OPTIONS    
    -h,--help
	Print help informations
    -l,--local
	Run only local folder
    -a,--all
	Search recursively inside folders
    --dry-run
	Run to test only. Show changes and files in duplicity

See the README for documentation.
https://github.com/brnfra/dotfiles
Licensed under the MIT license.
HELP
exit; 
;;

"-a"|"--all")
   search_duplicates "$2"

    ;;

"-l"|"--local")
   search_duplicates

    ;;

"--dry-run")
   search_duplicates_dryrun "$2" 
   
   ;;
*)
   cInfo "Run search_dupes -h"
   cError "Invalid choice"

    ;;
esac
}

userChoice "$@"
