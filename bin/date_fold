#!/usr/bin/env bash
# Arquivo: date_fold
# Autor: Bruno Franco
# Download: git@github.com:brnfra
# Licence:Este arquivo é de domínio público
# Garantia: O autor não se responsabiliza por eventuais danos
#           causados pelo uso deste script.
#   Tem o proposito de organizar os arquivos que tem nome padrão começando com
#   o template AAAAmmdd, sendo AAAA para digito do ano, mm para digitos do mes,
#   dd para digito do dia
#   cria pasta no padrão ./AAAA/mm e insere os arquivos
#   não se aplica a pastas ou nomes diferentes do padrão
# shellcheck source=dotfiles_env
. dotfiles_env

cInfo "Foldering files by date"

function cleaner() {	# {{{
    #Clean
    #rm -f /tmp/date_fold.log
    find . -type d -empty -delete &> /dev/null
    cInfo "Empty dirs removed"
}
# }}}
function isNum () { 	# {{{

    if [[ "$1" =~ ^[0-9]+$ ]]; then
	return 0;
    else
	return 1;
    fi
}
# }}}
function checkDate () { 	# {{{
    local DATE
    local YEAR
    local MONTH
    local today_year
    today_year=$( date +%Y )
    today_year=$(( today_year + 1 ))

    DATE="$1"
    YEAR=${DATE:0:4}
    MONTH=${DATE:4:2}

    if [ ${#1} -eq 8 ]	&&  ( isNum $YEAR )  && ( isNum $MONTH ) ;then
	if [ "$YEAR" -gt 1900 ] && [ "$MONTH" -gt 0 ] && [ 13 -gt "$MONTH" ] && [ "$today_year" -gt "$YEAR" ];then
	    return 0;
	else
	    return 1;
	fi
    else
	return 1;
    fi

}
# {{{}}}
function searchDate () {
    local YEAR
    local MONTH

    DEFAULT_IFS=$IFS
    IFS=$'-_.'

    read -ra parts <<< "$1"
    for part in "${parts[@]}"; do
	if [ ${#part} -eq 8 ] && ( checkDate $part ) && ( isNum $part );then 
	    echo "$part"
	fi
    done

    IFS=$DEFAULT_IFS
}

# }}}
function moveFile () { 	# {{{
    source ~/bin/dotfiles_env
    namestd "$1" &>/dev/null
    local Dir
    local DATE
    local File
    local file_name
    local file_dir
    local YEAR
    local MONTH
    File="$1"
    file_name=${File##*/}
    file_dir=${File%%/*}
    Dir='.'

    DATE=$( searchDate "$file_name" )

    if ( checkDate "$DATE" ) ; then
	YEAR=${DATE:0:4}
	MONTH=${DATE:4:2}
	if [[ "$HOME" != "$Dir" ]] && [[ ! -e "${Dir}/${YEAR}/${MONTH}/${file_name}" ]]; then
	    mkdir -p  "${Dir}/${YEAR}/${MONTH}"  &>>/tmp/date_fold.log
	    mv -f "$File" "${Dir}/${YEAR}/${MONTH}" &>>/tmp/date_fold.log
	else
	    printf "%s" ":${LINENO}:${FUNCNAME}:File already exists.(This script dont run in Home folder)." &>>/tmp/date_fold.log
	    exit 2
	fi
    else
	# last try
	DATE=$(stat -c %y $File | cut -d ' ' -f1 | tr -d '-')
	if ( checkDate "$DATE" ) ; then
	    YEAR=${DATE:0:4}
	    MONTH=${DATE:4:2}
	    if [[ "$HOME" != "$Dir" ]] && [[ ! -e "${Dir}/${YEAR}/${MONTH}/${file_name}" ]]; then
		mkdir -p  "${Dir}/${YEAR}/${MONTH}"  &>>/tmp/date_fold.log
		mv -f "$File" "${Dir}/${YEAR}/${MONTH}" &>>/tmp/date_fold.log
	    else
		printf "%s" ":${LINENO}:${FUNCNAME}:File already exists.(This script dont run in Home folder)." &>>/tmp/date_fold.log
	    fi
	else
	    printf "%s" ":${LINENO}:${FUNCNAME}:File date or not found" &>>/tmp/date_fold.log
	fi
    fi
    unset Dir
    unset File
    unset file_name
    unset YEAR
    unset MONTH
    unset today_year
    unset file_dir
    exit 0;

}
# }}}
#}}}
# chek files in dupes #{{{
function checkDupes () {
    local Dir
    local file_name
    Dir='.'
    echo "cheking dupes"
    # fdupes [op] dir no promt(preserve first)
    fdupes -N -dr $Dir | tee /tmp/fdupes.log

}



# #}}}
function userChoice() {

    case "$1" in
	#help {{{
	"-h"|"--help")
	cat <<HELP
${0##*/} 

NAME
    ${0##*/} - Organize files by date 

SYNOPSIS
    ${0##*/} [-h|--help] [-r|-R|--recursive]

DESCRIPTION
    Move files from the current folder, or its subfolders recursively,
    into new folders based on the date found in the filename (pattern: _YYYYmmdd_).

USAGE

    -r, -R, --recursively
	Check files recursively, create data folders in current path

    -h, --help
	Print help informations

See the README for documentation.
https://github.com/brnfra/dotfiles
Licensed under the MIT license.
HELP
exit;
;;

# }}}
# recursively {{{
"-r"|"-R"|"--recursive")

checkDupes

if find . -mindepth 1 -type f -print0 | parallel --bar -0 moveFile {} ;then
    cOk "All done"
else
    cError "${FUNCTION}:${LINENO}:Conversion error"
fi

;;

# }}}
# default{{{
*)

if find . -maxdepth 1 -type f -print0 | parallel --bar -0 moveFile {} ;then
    cOk "All done"
else
    cError "${FUNCTION}:${LINENO}:Conversion error"
fi

;;

# }}}
esac
}
export -f searchDate
export -f isNum
export -f checkDate
export -f searchDate
export -f moveFile
export -f checkDupes

userChoice "$1"
cleaner

unset -f searchDate
unset -f isNum
unset -f checkDate
unset -f searchDate
unset -f checkDupes
unset -f moveFile
