#!/usr/bin/env bash
# Arquivo: pomo
# Autor: Bruno Franco
# Download: git@github.com:brnfra
# Licence:Este arquivo é de domínio público
# Garantia: O autor não se responsabiliza por eventuais danos
#           causados pelo uso deste arquivo.
# Thanks to and adapted from [Original Author] duckl1ng/bog2n
# script from https://raw.githubusercontent.com/bog2n/i3blocks-pomodoro/master/pomodoro.sh
# repo: https://github.com/bog2n/i3blocks-pomodoro
source ~/bin/dotfiles_env

POMOS_COUNTER=$(( 0 ))
key_press=''
#loop pomodoro until user quit 25 min and 5 min
WORK_TIME=$(( 35 * 60 ))
BREAK_TIME=$(( 5 * 60 ))
DB="$HOME/.cache/pomodoro.db"
HORA_INI="$(date +%H:%M)"
DATA="$(date +%F)"
LOG="$HOME/.cache/pomodoro.log"
if [ ! -f $LOG ];then
    touch "$LOG"
fi

function createTable () {
    echo $DATA  &>$LOG
    echo $HORA_INI &>>$LOG

    sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS pomodoros 
    (id INTEGER PRIMARY KEY AUTOINCREMENT, data TEXT, 
    hora_inicio TEXT, hora_fim TEXT, concluidos INTEGER, tarefa TEXT);" &>>$LOG
}

function insertData (){
    echo $DATA  &>>$LOG
    echo $HORA_INI &>>$LOG

    local TAREFA
    HORA_END="$1"
    TAREFA="$2"
    sqlite3 "$DB" "INSERT INTO pomodoros (data, hora_inicio, hora_fim, concluidos, tarefa)
    VALUES ('$DATA', '$HORA_INI', '$HORA_END', '$POMOS_COUNTER', '$TAREFA');" &>>$LOG
}

function list () {
    echo $DATA  &>>$LOG
    echo $HORA_INI &>>$LOG

    sqlite3 "$DB" "SELECT * FROM pomodoros;" 2>>$LOG

}
function log () {
    cat < $LOG
}

function notification () {
    local MODE
    local NAME
    MODE="$1"
    NAME="${0##*/}"
    NAME="${NAME^^}"
    case $MODE in
	w) 
	    notify-send --urgency=normal "${NAME} - $2" "WORK time is over"
	    ffplay -nodisp -autoexit /usr/share/sounds/freedesktop/stereo/complete.oga &> /dev/null
	    ;;  #work
	b) 
	    notify-send --urgency=normal "${NAME} - $2" "PAUSE is over"
	    ffplay -nodisp -autoexit /usr/share/sounds/freedesktop/stereo/complete.oga &> /dev/null
	    ;; #break
    esac 
}

function timeCounter () {
    local TIME_MODE
    local MODE
    MODE="$1"
    #Tag = $2
    case $MODE in
	w) TIME_MODE=$(( $(date +%s) + WORK_TIME ));;	#work
	b) TIME_MODE=$(( $(date +%s) + BREAK_TIME ));;	#break
    esac 

    #loop to only timestop
    # while now + work_time is great or equal then now
    while [[ "$TIME_MODE" -ge $(date +%s) ]]; do
	if [[ $POMOS_COUNTER -gt 0 ]];then
	    printf "%s\r" "$(date -u --date @$(($TIME_MODE - $(date +%s))) +%H:%M:%S) [$POMOS_COUNTER] $2";
	else
	    printf "%s\r" "$(date -u --date @$(($TIME_MODE - $(date +%s))) +%H:%M:%S) $2";
	fi
	userChoice
	if [[ $? -eq 1 ]];then
	    return 1;
	fi
    done

}

function userChoice () {
    sleep 0.01
    read -s -n 1 -t 0.001 key_press
    case $key_press in
	'p'|'P')
	    clear
	    cInfo "POMODORO" "PAUSE"
	    key_press=""
	    STARTPAUSE=$(($(date +%s)))
	    #  tempo=$(time -p read -s -n 1 -p "Press some key to continue...")
	    read -s -n 1 -p "Press some key to continue..."
	    clear
	    ENDPAUSE=$(($(date +%s)))
	    DELTA=$(($ENDPAUSE - $STARTPAUSE))
	    TIME_MODE=$(($TIME_MODE + $DELTA))
	    return 0

	    ;;
	'q'|'Q')
	    #quit
	    return 1
	    ;;
    esac

}

function section () {
    mode='w' # mode
    while [ "$key_press" = '' ]; do
	# 	switch mode
	case $mode in
	    w)
		timeCounter "$mode" "$1"
		if [[ $? -eq 1 ]];then
		    break;
		fi
		POMOS_COUNTER=$(( POMOS_COUNTER + 1 ))
		notification "$mode" "$1"
		mode='b'
		;;
	    b)
		timeCounter "$mode" "$1"
		if [[ $? -eq 1 ]];then
		    break;
		fi
		notification "$mode" "$1"
		mode='w'
		;;
	esac

    done
    clear

}
case $1 in
    list) "$@"; exit;;
    log) "$@"; exit;;
    "-h"|"--help")

	cat <<HELP
${0##*/}

NAME
    ${0##*/} - Bash pomodoro timer

SYNOPSIS
    ${0##*/} {list|-h|--help}  [section or Tag]

DESCRIPTION
    The Pomodoro Technique is a time management method that uses 25-minute focused work sessions 
    followed by short breaks. After four sessions[TODO], a longer break is taken. It boosts focus, 
    reduces fatigue, and improves productivity.
    Database will be save in ~/.cache/pomodoro.db and error log in $LOG

    To start a new section withou tag 
	${0##*/}

    To start a new section with a tag or description
	${0##*/} tag|description

    To list sections on data base or show logs
	${0##*/} list|log

    To show this help
	${0##*/} -h|--help

OPTIONS
    list
	To show database sections
    -h,--help
	Print help informations


See the README for documentation.
https://github.com/brnfra/dotfiles
Licensed under the MIT license.
HELP
exit; 

;;

esac
# DataBase
createTable

#Init
section "$1"
# SESSÃO   1-QNT POMOS  2-TAREFA
HORA_END="$(date +%H:%M)"
if [ -z "$1" ] && [[ $POMOS_COUNTER -gt 0 ]] ;then
    insertData "$HORA_END" "Geral"
elif [[ $POMOS_COUNTER -gt 0 ]];then
    insertData "$HORA_END" "$1" 
fi
cInfo "SECTION POMOS:" "$POMOS_COUNTER"
cInfo "POMODORO:" "Quit"
