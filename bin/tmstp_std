#!/usr/bin/env bash
# Arquivo: tmstp_std
# Autor: Bruno Franco
# Ultima_modificacao: 13-03-2026
# Download: git@github.com:brnfra
# Licence:Este arquivo é de domínio público
# Garantia: O autor não se responsabiliza por eventuais danos
#           causados pelo uso deste script.
# shellcheck source=dotfiles_env
source dotfiles_env

cInfo "Recria e padroniza timestamps nos videos evitando erros de sync entre audio e vídeo."

if ! which ffmpeg &> /dev/null
then
    cError "ffmpeg is not installed. Please install ffmpeg it and try again."
    exit 2
fi

function timestampsNormalize() {
    source dotfiles_env
    local path #pasta de origem ex root/file path=root/
    local name
    local fps
    local filter
    local ffmpeg_nrm
    local avoSeek

    #  
    avoSeek=( -threads 1 -avioflags direct -analyzeduration 10M -probesize 10M -fflags +genpts+nobuffer+igndts )
    fps="fps=30,format=yuv420p"
    filter="aresample=async=1:first_pts=0"
    # ffmpeg_nrm=( -c:v libx264 -preset veryfast -crf 18 -c:a aac -ar 44100 -ac 2 )
    #Teste para nao precisar CFR
    ffmpeg_nrm=( -map 0:v -map 0:a -c:v copy -c:a aac -b:a 128k )
	
    if [ ! -z $2 ];then
	path="$1"
    fi
    name="${2:-"$1"}"
    name="${name%.*}.mp4"

    if [ -s "$2" ] && [ ! -z "$2" ]; then
#Teste para nao precisar CFR	ffmpeg "${avoSeek[@]}" -i "${2}" -vf "${fps}" -af "${filter}" "${ffmpeg_nrm[@]}" "${path}/${name}" &> "/tmp/${FUNCNAME[0]}.log" 
	ffmpeg "${avoSeek[@]}" -i "${2}" -af "${filter}" "${ffmpeg_nrm[@]}" "${path}/${name}" &> "/tmp/${FUNCNAME[0]}.log" 
	if [ ! $? -eq 0 ];then
	    cError "${FUNCTION}:${LINENO}:Conversion error"
	fi
	return;
    elif [ -s "$1" ]; then
#Teste para nao precisar CFR	ffmpeg "${avoSeek[@]}" -i "$1" -vf "${fps}" -af "${filter}" "${ffmpeg_nrm[@]}" "./norm_${name}" &> "/tmp/${FUNCNAME[0]}.log" 
	ffmpeg "${avoSeek[@]}" -i "$1" -af "${filter}" "${ffmpeg_nrm[@]}" "./norm_${name}" &> "/tmp/${FUNCNAME[0]}.log" 
	return;
    else
	cError "${FUNCTION}:${LINENO}:$1 is not a valid file."
	exit 1
    fi

    unset path
    unset name
    unset ffmpeg_opus
}


function userChoice() {
    cInfo "${0##*/}"
    case "$1" in

	"-a"|"--all")
	    local saveDir
	    saveDir='norm'

	    # Create the output directory if it doesn't exist
	    if [ ! -d "$saveDir" ]
	    then
		mkdir -p "$saveDir"
	    fi

	    FILES_LIST=$(find . -maxdepth 1 -type f -exec file --mime-type {} + | grep -E 'audio/|video/' | cut -d: -f1 | sed 's|\.\/||gi' )
	    DEFAULT_IFS=$IFS
	    IFS=$'\n'
	    files_list=( $FILES_LIST )
	    IFS=$DEFAULT_IFS

	    export -f timestampsNormalize
	    parallel -j 5 --bar timestampsNormalize "${saveDir}" {} ::: "${files_list[@]}"
	    if [ $? -eq 0 ];then
		cOk "All done"
	    else
		cError "${FUNCTION}:${LINENO}:Conversion error"
	    fi
	   
	    ;;

	"-h"|"--help")

	    cat <<HELP
${0##*/}

NAME
    ${0##*/} - Normalize timestamps for concat videos with ffmpeg

SYNOPSIS
    ${0##*/} {-a|--all|-h|--help | filename }

DESCRIPTION
    Se os vídeos têm codecs diferentes, ou se você deseja garantir a compatibilidade, pode ser 
    necessário re-encodificar os vídeos. Onde ocorre esses erros essa solução normaliza e resolve
    a falta de sincronia entre audio e vídeo.
    The bitrate is 34k. For more info: http://ffmpeg.org/ffmpeg-codecs.html#libopus-1

    To normalize a single video
	${0##*/} file_name.mp4
	output: ./norm/file_name.mp4
    To normalize all videos in current folder
	${0##*/} -a|--all
	Will create a folder and set output there.
	output: ./norm/file_name.mp4

OPTIONS
    -a,--all
	To normalize all videos files in current folder
    -h,--help
	Print help informations

Exit status:
       0      if OK,

       1      no valid files(ffmpeg not compatible).

       2      ffmpeg is not installed.

       3      no file selected.

See the README for documentation.
https://github.com/brnfra/dotfiles
Licensed under the MIT license.
HELP
exit; 

;;

	*)
	    local saveDir
	    saveDir='norm'
	    
	    # Create the output directory if it doesn't exist
	    if [ ! -d "$saveDir" ]
	    then
		mkdir -p "$saveDir"
	    fi

	    if [ -s "$1" ]; then
		timestampsNormalize "${saveDir}" "${1}"
	    else
		echo $1
		cError "${FUNCTION}:${LINENO}:$1 is not a valid file."
	    exit 1
	    fi

	;;

    esac

    case "$2" in

	"-c"|"--concat")
	    local saveDir
	    saveDir='norm'

	    cd "${saveDir}" || return
	    concat_videos -a
	    ;;
	*)
	    cInfo "No concat"
	    ;;

    esac
}


if [ -z "$1" ]; then
    cError "${FUNCTION}:${LINENO}:No option or file selected."
    userChoice -h
    exit 3
fi

# normalize the names and check if already done
if [ $? -eq 0 ] && [ ! -s names_checked ];then
    namestd -l
    cOk "All done"
    echo "names ok" > names_checked
else
    cInfo "Names already checked"
fi

userChoice "$@"
#cleaner

