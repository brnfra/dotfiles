#           causados pelo uso deste script.
# shellcheck source=dotfiles_env
source dotfiles_env

cInfo "Imprime duração dos vídeos."


function getDuration () {

    ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "${1}" | bc
}

function userChoice () {
	local time
	local seg

    cInfo "${0##*/}"

    case "$1" in


	"-a"|"--all")

	 for file in *.mp4; do
	     time=$(getDuration "$file")
	     seg=${time%.*}

	     printf "%s - %02d:%02d:%02d\n" "$file" $((seg/3600)) $(((seg%3600)/60)) $((seg%60))

	 done

	if [ $? -eq 0 ];then
	    cOk "All done"
	else
	    cError "${FUNCTION}:${LINENO}:Error on get durations"
	fi

	;;

    "-h"|"--help")

	cat <<HELP
	    ${0##*/}

	NAME
	    ${0##*/} - Get duration from videos files

	    SYNOPSIS
	    ${0##*/} {-a|--all|-h|--help | filename }

	DESCRIPTION
	    Get time vídeos duration with ffprobe using ffmpeg

	    To get a single video
	    ${0##*/} file_name.mp4
	    
	    To get from all videos in current folder
	    ${0##*/} -a|--all
	    
	    

	    OPTIONS
	    -a,--all
	    To get from all videos files in current folder
	    -h,--help
	    Print help informations

	    Exit status:
	    0      if OK,

	    1      no valid files(ffmpeg not compatible).

	    2      ffmpeg is not installed.

	    3      no file selected.

	    See the README for documentation.
	    https://github.com/brnfra/dotfiles
	    Licensed under the MIT license.
HELP
exit; 

	       ;;

		   *)

		    if [ -s "$1" ]; then
		    	time=$(getDuration "$1")
		        seg=${time%.*}

			printf "%s - %02d:%02d:%02d\n" "$1" $((seg/3600)) $(((seg%3600)/60)) $((seg%60))


		    else
			echo $1
			cError "${FUNCTION}:${LINENO}:$1 is not a valid file."
			exit 1
		    fi

		    ;;

		esac
	    }


if [ -z "$1" ]; then
    cError "${FUNCTION}:${LINENO}:No option or file selected."
    userChoice -h
    exit 3
fi

# normalize the names and check if already done
if [ $? -eq 0 ] && [ ! -s names_checked ];then
    namestd -l
    cOk "All done"
    echo "names ok" > names_checked
else
    cInfo "Names already checked"
fi



userChoice "$@"
#cleaner
