backto=$(pwd)
branch="stow"

# make executables in src/ visible to PATH
# Color {{{ 
# escape
E='\033['
italic="${E}3m"
reset="${E}0m"
bold="${E}1m"
# Set foreground colors
red="${E}31m"
green="${E}32m"
cyan="${E}36m"
grey="${E}2m"
cInfo() {
    printf "${grey}%s${reset} %s${cyan}${bold}${italic} %s${reset} %s\n"  "[INFO]" "$1" "$2" "$3"
}
cError() {
    printf "${red}%s${reset} %s${cyan}${bold}${italic} %s${reset} %s\n" "[FAIL]" "$1" "$2" "$3"
}
cOk() {
    printf "${green}%s ${reset}%s\n" "[ OK ]" "$1"
}

#}}}
#pre_install_check {{{
pre_install_check() {
    cInfo "Executing: " "${FUNCNAME[0]}"
    local git='type git'
    local curl='type curl'
    local ssh='type ssh'
    local stow='type stow'
    local bin_dir
    local env_file
    local env_hash_file
    env_file="dotfiles_env"
    env_hash_file="dotfiles_env.sha256"
    bin_dir="$HOME/bin"
    mkdir "$bin_dir"
    cd "$bin_dir" || return
    PATH="$bin_dir/../src:$PATH"
    
    #packages
    if ! $git &> /dev/null;then
	cError "Git not found. Abort install."
	exit 2	
    fi
    if ! $curl &> /dev/null;then
	cError "Curl not found. Abort install."
	exit 3	
    fi
    if ! $ssh &> /dev/null;then
	cError "Ssh not found. Abort install."
	exit 4	
    fi
   if ! $stow &> /dev/null;then
	cError "Stow not found. Abort install."
	exit 5	
    fi

    # if there are definitions file 
  if [[ -e "$HOME/bin/${env_file}" || -e "$HOME/bin/${env_hash_file}" ]]; then
      # hash verify
    cInfo "Verify integrity of dotfiles_env..."
    if sha256sum -c "$HOME/bin/$env_hash_file"; then
    	cOk "dotfile_env"
	# If dotfiles_env is valid
	. "$HOME/bin/$env_file"
    else
	echo "Error: dotfile_env is not a valid file."
	exit 1
    fi
  else
	curl -O --max-time 15 "https://raw.githubusercontent.com/brnfra/dotfiles/stow/bin/${env_file}"
	curl -O --max-time 15 "https://raw.githubusercontent.com/brnfra/dotfiles/stow/bin/${env_hash_file}"
	if [[ -e "$HOME/bin/${env_file}" || -e "$HOME/bin/${env_hash_file}" ]]; then
	    # hash verify
	    cInfo "Verify integrity of dotfiles_env..."
	    if sha256sum -c "$HOME/bin/$env_hash_file"; then
		cOk "dotfile_env"
		# If dotfiles_env is valid
		. "$HOME/bin/$env_file"
	    else
		echo "Error: dotfile_env is not a valid file."
		exit 1
	    fi
	else
	    cError "dotfiles_env doesn't exist.\n"
	    exit 1
	fi
  fi
    if [ ! -e "$dotfiles_dir" ]; then
	mkdir -p "$dotfiles_dir"
	if [ -e "$dotfiles_dir" ]; then
	    cInfo "Created" "$dotfiles_dir" "folder"
	else
	    cError " Fail to create:" "$dotfiles_dir"
	fi
    else
	cOk "Folder" "$dotfiles_dir" 
    fi

    cInfo "${FUNCNAME[0]}" "Done"
    backup_cfg_files
    
    unset git
    unset curl
    unset ssh
    unset stow
    unset bin_dir
    unset env_file
    unset env_hash_file
}
##}}}
# backup {{{
backup_cfg_files() {
    #before backup
    cd / || exit 1
    if [ ! -e "${bkpdir}/original" ];then
	mkdir -p "${bkpdir}/original"
	cInfo "Backup folder created:" "${bkpdir}/original"
    else
	cOk "$bkpdir"
    fi

    cInfo "Backuping: " "${0##*/} - ${FUNCNAME[0]}" 
    cInfo "Get folders"
    
    for dir in "${Dirs[@]}"; do
	if [ -e "${HOME}/${dir}/" ];then 
	    mkdir -p "${bkpdir}/original/${dir}/"
	    mv "${HOME}/${dir}/" "${bkpdir}/original/" 
	    if [ ! -e "${HOME}/${dir}/" ] && [ -e "${bkpdir}/original/${dir}/" ];then 
		cOk "${HOME}/$dir" 
	    else
		cError "Not moved or not found in:" "${bkpdir}/original/${dir}"
	    fi
	else
	    cInfo "Skip folder:" "[${HOME}/${dir}]"
	fi
    done

    cInfo "Get files"
    echo "$files"
    for item in "${files[@]}"; do
	if [ -e "${HOME}/${item}" ];then 
	    mv -v "${HOME}/${item}" "${bkpdir}/original/${item}" 
	    if [ ! -e "${HOME}/${item}" ] && [ -e "${bkpdir}/original/${item}" ];then 
		cOk "${HOME}/$item"
	    else
		cError "Fail to move file: ${HOME}/${item}"
	    fi
	else
	    cInfo "Skip file : " "[${HOME}/$item]"
	fi
    done


    cInfo "Done!" "${0##*/} - ${FUNCNAME[0]}"
    cInfo "Defaul config moved to: " "${bkpdir}"
}
##}}}
#install{{{

install_dotfiles() {
   
    cd / || exit 1
    cInfo "Git clone (dotfiles):" "$branch" "in $dotfiles_dir"
    if git clone -v --single-branch -b "$branch" --depth 1 "$repository" "$dotfiles_dir"; then
	cOk "Git clone"

	if [ -e "$dotfiles_dir" ];then
	    cd "$dotfiles_dir" || return

	    if stow --dotfiles --target="$HOME" --no-folding -R . ;then
		cInfo "Symlinks created"
		cInfo "Executing bin/enviroment_config"
		if [ -e ~/bin/enviroment_config ]; then
		    bash ~/bin/enviroment_config 
		else
		    cError "Enviroment_config not found."
		    exit 127
		fi
	    else
		cError "Stow"
		exit 127
	    fi

	else
	    cError "Not found: " "$dotfiles_dir"
	fi

	cInfo "${0##*/} complete." 
    else
	cError "Clone repository"
	printf "[ERROR] Clone repository. %s - fail\n" "${0##*/}"
	exit 1
    fi

}
###}}}

cd "$HOME" || return
cInfo "Installing" "${user_name}" "dotfiles."

pre_install_check
install_dotfiles

unset E
unset italic
unset reset
unset bold
unset red
unset green
unset cyan
unset grey

cd "$backto" || return

